RECREATE Pagelink process_view_create__sys (
   label('ProcessView Create'),
   description('Redirects to the ProcessMonitorPage to create a ProcessView'),
   url('https://{{Vault.domain}}/ui/#sys/page/{{Page.url_path_name}}'),
   mode('Create'),
   page_type('Object'),
   object('Object.process_view__sys'),
   active(true),
   disable_type_select(false),
   page('Page.process_monitor__sys')
);