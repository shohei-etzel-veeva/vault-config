RECREATE Pagelink process_view_view__sys (
   label('ProcessView View'),
   description('Redirects to the ProcessMonitorPage to view a ProcessView'),
   url('https://{{Vault.domain}}/ui/#sys/page/{{Page.url_path_name}}?processView={{Object.id}}'),
   mode('View'),
   page_type('Object'),
   object('Object.process_view__sys'),
   active(true),
   disable_type_select(false),
   page('Page.process_monitor__sys')
);