RECREATE Pagelink process_view_copy__sys (
   label('ProcessView Copy'),
   description('Redirects to the ProcessMonitorPage to copy a ProcessView'),
   url('https://{{Vault.domain}}/ui/#sys/page/{{Page.url_path_name}}?sourceProcessView={{Related.SourceId}}&mode=copy'),
   mode('Copy'),
   page_type('Object'),
   object('Object.process_view__sys'),
   active(true),
   disable_type_select(false),
   page('Page.process_monitor__sys')
);