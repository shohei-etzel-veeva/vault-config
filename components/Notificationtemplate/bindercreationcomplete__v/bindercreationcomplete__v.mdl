RECREATE Notificationtemplate bindercreationcomplete__v (
   label('binderCreationComplete'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Binder Created (${docNameNoLink})'),
   notification('<p>Binder created: <b>${docName}</b></p>
<p>including any planned documents in the template.</p>'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Binder Created</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Your binder ''${docName}'' has been created, including any planned documents included in the binder template.</p>

<p>Click here to see all your Vault notifications: ${notificationHome}</p>'),
   entity_type('document'),
   notification_category('none__sys')
);