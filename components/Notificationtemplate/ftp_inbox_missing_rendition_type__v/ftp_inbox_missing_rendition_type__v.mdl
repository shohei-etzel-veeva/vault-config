RECREATE Notificationtemplate ftp_inbox_missing_rendition_type__v (
   label('Missing Rendition Type'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: FTP Inbox failed to add ''${fileName}'' to ''${docName}'' (insufficient permission)'),
   notification('FTP Inbox failed to add ''${fileName}'' to ''${docName}'' because you did not specify a rendition type.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>FTP Inbox failed to add rendition to document</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>FTP Inbox failed to add ''${fileName}'' to ''${docName}'' because you did not specify a rendition type.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);