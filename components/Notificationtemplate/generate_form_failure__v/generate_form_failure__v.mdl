RECREATE Notificationtemplate generate_form_failure__v (
   label('Generate Form Failure'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: Form Generation Failed'),
   notification('Form generation for ${docName} failed.

<p>Error: ${generateFormError}</p>'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Form Generation Failed</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Form generation for ${docName} failed.</p>

<p>Error: ${generateFormError}</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);