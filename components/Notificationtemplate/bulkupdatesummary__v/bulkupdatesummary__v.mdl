RECREATE Notificationtemplate bulkupdatesummary__v (
   label('bulkUpdateSummary'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: Bulk Action Completed'),
   notification('Bulk action change summary:
<br>${bulkUpdatesList}
<br>${bulkFailuresHeader} ${bulkSuccessHeader}'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Bulk Action Completed</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Bulk action change summary:
<br>${bulkUpdatesList}
<br>${bulkFailuresHeader} ${bulkSuccessHeader}</p>

<b>Results:</b> <br> ${bulkFailuresHeader} ${bulkFailuresList} ${bulkSuccessHeader} ${bulkSuccessList}

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);