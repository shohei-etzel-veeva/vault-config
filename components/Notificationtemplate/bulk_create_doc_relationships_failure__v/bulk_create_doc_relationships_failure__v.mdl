RECREATE Notificationtemplate bulk_create_doc_relationships_failure__v (
   label('Bulk Create Doc Relationships Failure'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: Error Creating Document Relationships (${docName})'),
   notification('Error creating document relationships for ${docName}'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Error creating document relationships</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>There was an error creating document relationships for your document: ${docName}.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);