RECREATE Notificationtemplate version_specific_attachment_job_failure__v (
   label('versionSpecificAttachmentJobFailure'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: Version-specific Attachment Enablement Warning'),
   notification('Some attachments failed to be assigned to specific document versions whilst enabling the ''version-specific attachments'' feature. Please contact your Vault administrator.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Version-specific attachments enablement warning</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>${notificationMessage}</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);