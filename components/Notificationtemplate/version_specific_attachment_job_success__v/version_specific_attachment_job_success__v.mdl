RECREATE Notificationtemplate version_specific_attachment_job_success__v (
   label('versionSpecificAttachmentJobSuccess'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Version-specific Attachments Enabled'),
   notification('Version-specific attachments has been successfully enabled for your vault, and all existing attachments have been successfully assigned to the relevant document versions.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Version-specific attachments enabled</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>${notificationMessage}</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);