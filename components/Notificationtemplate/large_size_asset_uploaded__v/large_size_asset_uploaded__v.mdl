RECREATE Notificationtemplate large_size_asset_uploaded__v (
   label('Large Size Asset Uploaded'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Large size asset uploaded to ''${docName}'''),
   notification('Large Size Asset uploaded to ''${docName}''.
<br>Access your Document Inbox to classify the document into your document library.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Large size asset uploaded</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Your large size asset file has been uploaded to ''${docName}''. Access your document inbox to classify the document, which will enter it into your document library.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);