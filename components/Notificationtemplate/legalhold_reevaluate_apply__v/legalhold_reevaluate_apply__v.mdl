RECREATE Notificationtemplate legalhold_reevaluate_apply__v (
   label('legalHoldReevaluateSuccess_b'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Legal hold (re-evaluated)'),
   notification('<p>Legal hold ${legalHoldObjectLink} successfully re-evaluated for ${appliedDocumentCount} documents.</p>'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Legal hold re-evaluated</b></p>

<p>${recipientName},</p>

<p>${notificationMessage}</p>

<p><a href="${taskHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('object'),
   notification_category('none__sys')
);