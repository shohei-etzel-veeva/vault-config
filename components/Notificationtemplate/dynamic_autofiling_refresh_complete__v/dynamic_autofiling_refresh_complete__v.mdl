RECREATE Notificationtemplate dynamic_autofiling_refresh_complete__v (
   label('Binder Auto-filing Refresh Complete'),
   active(true),
   description('Notification sent upon completion of a request to refresh auto-filing on a binder.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Binder Auto-filing Refresh Completed (${docNameNoLink})'),
   notification('<p>Binder auto-filing refresh completed for ''${docName}''.</p>
Successfully auto-filed ${addedDocsCount} documents into ${addedSectionsCount} sections. Removed ${removedDocsCount} documents from ${removedSectionsCount} sections. Retained ${manuallyFiledDocsCount} because they are manually filed.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Binder auto-filing refresh completed</b></p>

<p>${recipientTitle} ${recipientName},</p>

<b>Refresh Requested:</b> ${autofileStartDateTime}<br>
<b>Refresh Completed:</b> ${autofileEndDateTime}</p>

<p><b>Results:</b></p>
<p>${autofileAddedDocsHeader} ${autofileAddedDocs}</p>
<p>${autofileRemovedDocsHeader} ${autofileRemovedDocs}</p>
<p>${autofileManuallyFiledDocsHeader} ${autofileManuallyFiledDocs}</p>
<p>${autofileVersionBoundDocsHeader} ${autofileVersionBoundDocs}</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);