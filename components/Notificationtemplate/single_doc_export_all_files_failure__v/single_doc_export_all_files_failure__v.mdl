RECREATE Notificationtemplate single_doc_export_all_files_failure__v (
   label('documentExportSizeLimit'),
   active(true),
   description(),
   email_preferences('every_occurrence__sys'),
   referenced_component(),
   subject('Veeva Vault: Document Export File Size Limit Exceeded (${docNameNoLink})'),
   notification('Document export for ${docName} failed because it exceeded the maximum export file size.
<br>Try again with fewer documents or document artifacts selected.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Document export maximum file size exceedeed</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Document export for ${docName} failed because it exceeded the maximum export file size.
<br>Try again with fewer documents or document artifacts selected.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);