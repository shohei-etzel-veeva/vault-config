RECREATE Notificationtemplate dynamic_autofiling_complete__v (
   label('Binder Auto-filing Complete'),
   active(true),
   description('Notification sent upon completion of a request to perform auto-filing on a binder.'),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Binder Auto-filing Completed (${docNameNoLink})'),
   notification('<p>Binder auto-filing complete for ''${docName}''.</p>
Successfully auto-filed ${addedDocsCount} documents into ${addedSectionsCount} sections.'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Binder auto-filing completed</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Binder auto-filing completed for ''${docName}'' on ${autofileEndDateTime}.

<p>${autofileAddedDocsHeader} ${autofileAddedDocs}</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);