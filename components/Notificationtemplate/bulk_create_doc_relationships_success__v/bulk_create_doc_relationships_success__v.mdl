RECREATE Notificationtemplate bulk_create_doc_relationships_success__v (
   label('Bulk Create Doc Relationship Success'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Document Relationships Created (${docNameNoLink})'),
   notification('<p>${numDocumentRelationshipsCreated} document relationships created for ''${docName}''</p>'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Document relationships created</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p>Vault successfully created ${numDocumentRelationshipsCreated} relationships for your document: ${docName}.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('none__sys')
);