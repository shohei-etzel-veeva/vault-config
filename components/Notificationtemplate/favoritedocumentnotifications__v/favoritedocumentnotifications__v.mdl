RECREATE Notificationtemplate favoritedocumentnotifications__v (
   label('FavoriteDocumentNotifications'),
   active(true),
   description(),
   email_preferences('summary__sys'),
   referenced_component(),
   subject('Veeva Vault: Favorite Document ''${docName}'' updated by ${senderName}'),
   notification('Favorite document ''${docName}'' updated by ${senderName}.
<br>${updateDetails}'),
   email_body('<p><b>Vault: </b>${vaultName} (${uiBaseExtUrl})
<br>
<b>Notification: </b>Favorite Document Notification</b></p>

<p>${recipientTitle} ${recipientName},</p>

<p><b>${senderName}</b> has updated a document you have marked as a favorite document: ''${docName}''.
<br>${updateDetails}</p>

<p>To stop notifications for this document, remove it from your favorite documents. To stop receiving favorite document notifications, modify your notification settings on your User Profile page.</p>

<p><a href="${notificationHome}">Click here to see all your Vault notifications</a> </p>'),
   entity_type('document'),
   notification_category('favorite_documents__sys')
);