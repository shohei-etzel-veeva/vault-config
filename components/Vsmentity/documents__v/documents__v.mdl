RECREATE Vsmentity documents__v (
   label('Documents'),
   active(true),
   description('A Vault document — any file managed in the document library (SOPs, forms, guidance, reports, executed records, etc.), across every document type. Use for questions about documents in general: find or count documents by type/subtype, status, lifecycle, version, language, creator, or created/modified date. In VQL query FROM documents. Each row is one document version — filter latest_version__v = true for the current version to avoid double-counting older versions.'),
   synonyms('documents',
      'doc',
      'docs',
      'file',
      'files',
      'content'),
   target('Object.documents'),
   target_label('Documents'),
   Vsmfield(@Vsmfield/binder__v.mdl),
   Vsmfield(@Vsmfield/classification__v.mdl),
   Vsmfield(@Vsmfield/created_by__v.mdl),
   Vsmfield(@Vsmfield/document_creation_date__v.mdl),
   Vsmfield(@Vsmfield/document_number__v.mdl),
   Vsmfield(@Vsmfield/filename__v.mdl),
   Vsmfield(@Vsmfield/format__v.mdl),
   Vsmfield(@Vsmfield/language__v.mdl),
   Vsmfield(@Vsmfield/last_modified_by__v.mdl),
   Vsmfield(@Vsmfield/latest_version__v.mdl),
   Vsmfield(@Vsmfield/lifecycle__v.mdl),
   Vsmfield(@Vsmfield/major_version_number__v.mdl),
   Vsmfield(@Vsmfield/minor_version_number__v.mdl),
   Vsmfield(@Vsmfield/name__v.mdl),
   Vsmfield(@Vsmfield/pages__v.mdl),
   Vsmfield(@Vsmfield/size__v.mdl),
   Vsmfield(@Vsmfield/status__v.mdl),
   Vsmfield(@Vsmfield/subtype__v.mdl),
   Vsmfield(@Vsmfield/title__v.mdl),
   Vsmfield(@Vsmfield/type__v.mdl),
   Vsmfield(@Vsmfield/version_creation_date__v.mdl),
   Vsmfield(@Vsmfield/version_modified_date__v.mdl)
);