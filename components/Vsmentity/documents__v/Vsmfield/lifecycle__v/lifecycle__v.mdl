Vsmfield lifecycle__v (
   label('Lifecycle'),
   active(true),
   description('The lifecycle the document follows (e.g. Draft to Effective Lifecycle), which defines its set of possible statuses. Use to filter documents by lifecycle. IMPORTANT: this names the lifecycle, not the current step — the current step is status__v.'),
   example_values(),
   synonyms('lifecycle',
         'document lifecycle',
         'process'),
   target('lifecycle__v'),
   target_label('Lifecycle'),
   vsm_picklist(),
   vsm_picklist_local()
);