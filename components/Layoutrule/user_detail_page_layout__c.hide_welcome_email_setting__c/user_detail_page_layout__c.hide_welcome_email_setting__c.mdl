RECREATE Layoutrule user_detail_page_layout__c.hide_welcome_email_setting__c (
   active(true),
   description('Hides the option to disable welcome emails for users who have already accessed the Vault'),
   displayed_as_readonly_fields(),
   displayed_as_required_fields(),
   expression('last_login__sys <= Today()'),
   focus_on_layout(false),
   hidden_pages(),
   hide_controls(),
   hide_fields('send_welcome_email__sys'),
   hide_sections(),
   hide_layout(false),
   label('Hide welcome email setting'),
   order(100)
);